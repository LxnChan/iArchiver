IPHONEOS_DEPLOYMENT_TARGET = 18.0
SDKROOT = iphoneos
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
TARGETED_DEVICE_FAMILY = 1,2
ARCHS = arm64
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IARCHIVER_BUNDLE_PREFIX = com.example
CODE_SIGN_STYLE = Automatic
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
DEAD_CODE_STRIPPING = YES
IA_NATIVE_SLICE[sdk=iphoneos*] = ios-arm64
IA_NATIVE_SLICE[sdk=iphonesimulator*] = ios-arm64-simulator
IA_NATIVE_ROOT = $(SRCROOT)/Build/Apple/ArchiveCore-$(IA_VARIANT).xcframework/$(IA_NATIVE_SLICE)
SWIFT_INCLUDE_PATHS = $(inherited) "$(IA_NATIVE_ROOT)/Headers"
HEADER_SEARCH_PATHS = $(inherited) "$(IA_NATIVE_ROOT)/Headers"
// xcodebuild preserves the input archive name when creating each XCFramework slice.
IA_NATIVE_LIBRARY = $(IA_NATIVE_ROOT)/$(IA_VARIANT)-$(PLATFORM_NAME).a
OTHER_LDFLAGS = $(inherited) -liconv -lc++ -force_load "$(IA_NATIVE_LIBRARY)"
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
#include? "Local.xcconfig"

