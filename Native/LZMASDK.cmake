# A library-only source manifest derived from the upstream Format7zR bundle.
# No command-line UI, executable loader, external codec loader or SFX code.
set(IA_SDK "${CMAKE_CURRENT_SOURCE_DIR}/../.deps/src/lzma-sdk-26.06")
file(READ "${IA_SDK}/CPP/7zip/Bundles/Format7zR/makefile" IA_SDK_MAKEFILE)
string(REGEX MATCHALL "\\$O\\\\[A-Za-z0-9_]+\\.obj" IA_SDK_OBJECTS "${IA_SDK_MAKEFILE}")
file(GLOB_RECURSE IA_SDK_FILES CONFIGURE_DEPENDS "${IA_SDK}/CPP/*.cpp" "${IA_SDK}/C/*.c")
set(IA_SDK_SOURCES)
foreach(IA_OBJECT IN LISTS IA_SDK_OBJECTS)
  string(REGEX REPLACE "^.*\\\\([A-Za-z0-9_]+)\\.obj$" "\\1" IA_BASENAME "${IA_OBJECT}")
  if(IA_BASENAME MATCHES "^(ArchiveExports|DllExports2|7zRegister|NewHandler)$")
    continue()
  endif()
  set(IA_MATCHES)
  foreach(IA_FILE IN LISTS IA_SDK_FILES)
    get_filename_component(IA_STEM "${IA_FILE}" NAME_WE)
    if(IA_STEM STREQUAL IA_BASENAME)
      list(APPEND IA_MATCHES "${IA_FILE}")
    endif()
  endforeach()
  list(LENGTH IA_MATCHES IA_MATCH_COUNT)
  if(NOT IA_MATCH_COUNT EQUAL 1)
    message(FATAL_ERROR "Ambiguous or missing SDK object: ${IA_BASENAME}: ${IA_MATCHES}")
  endif()
  list(APPEND IA_SDK_SOURCES ${IA_MATCHES})
endforeach()
foreach(IA_EXTRA C/7zCrc.c C/7zCrcOpt.c C/LzFindOpt.c C/Aes.c C/AesOpt.c C/Sha256.c C/Sha256Opt.c
    CPP/Common/UTFConvert.cpp CPP/Common/IntToString.cpp
    CPP/7zip/Crypto/7zAes.cpp CPP/7zip/Crypto/7zAesRegister.cpp
    CPP/7zip/Crypto/MyAes.cpp CPP/7zip/Crypto/MyAesReg.cpp CPP/7zip/Crypto/RandGen.cpp)
  list(APPEND IA_SDK_SOURCES "${IA_SDK}/${IA_EXTRA}")
endforeach()
if(NOT WIN32)
  list(APPEND IA_SDK_SOURCES "${IA_SDK}/CPP/Common/MyWindows.cpp")
endif()
list(REMOVE_DUPLICATES IA_SDK_SOURCES)
